    "m_SourceType": 1,
    "m_FunctionName": "test",
    "m_FunctionSource": "",
    "m_FunctionBody": "if (0 <=  _BamiriCount && _BamiriCount < 1.5)\n{\noutColor = inColor1;\n}\nif (1.5 <= _BamiriCount && _BamiriCount < 2.5)\n{\noutColor = inColor2;\n}\nif (2.5 <= _BamiriCount && _BamiriCount < 3.5)\n{\noutColor = inColor3;\n}\nif (3.5 <= _BamiriCount && _BamiriCount < 4.5)\n{\noutColor = inColor4;\n}\ntestOut = _BamiriCount;\n\n\nif(_testBool)\n{\ncolor = float3(_BamiriCount, 1.0, 1.0);\n}\n\n{\ncolor = float3(0.0, 1.0, 1.0);\n\n}"
}

